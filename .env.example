POSTGRES_DB=opennosh
POSTGRES_USER=opennosh
POSTGRES_PASSWORD=opennosh
APP_ENVIRONMENT=development
# Production deployments must use distinct least-privilege role credentials.
WEB_DATABASE_URL=
MIGRATION_DATABASE_URL=
ADMINISTRATION_DATABASE_URL=
# Generate and set a unique 32+ character value before a production Compose deployment.
WEB_PROXY_TOKEN=
FOOD_SEARCH_RATE_LIMIT_ATTEMPTS=120
FOOD_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
FOOD_SEARCH_STATEMENT_TIMEOUT_MS=500
# Replace this development key with a unique 32+ byte secret before production.
# During rotation, append the previous key as a second comma-separated kid:secret entry.
FOOD_SEARCH_CURSOR_SIGNING_KEYS=v1:opennosh-development-search-cursor-key-2026
FOOD_SEARCH_CURSOR_LIFETIME_SECONDS=900
FOOD_SEARCH_SNAPSHOT_REFRESH_SECONDS=300
FOOD_SEARCH_SNAPSHOT_RETENTION_SECONDS=1200
FOOD_SEARCH_SNAPSHOT_BUILD_TIMEOUT_MS=30000
# Signed public-commons artifacts are mounted read-only into the API container.
PUBLIC_COMMONS_ARTIFACT_DIRECTORY=./var/public-commons
PUBLIC_COMMONS_STATE_DIRECTORY=./var/public-commons-state
# Native deployments may instead set these artifact and durable-state paths directly.
PUBLIC_COMMONS_LATEST_POINTER_PATH=
PUBLIC_COMMONS_RELEASE_DIRECTORY=
PUBLIC_COMMONS_CHECKPOINT_PATH=
PUBLIC_COMMONS_PROJECTION_PATH=
PUBLIC_COMMONS_REFRESH_SECONDS=5
PUBLIC_COMMONS_REVALIDATION_URL=
PUBLIC_COMMONS_REVALIDATION_TOKEN=
PUBLIC_COMMONS_REVALIDATION_ALLOWED_HOSTS=web,localhost,127.0.0.1,::1
# Replace this development verifier with approved Ed25519 public keys before production.
# During rotation, retain comma-separated key-id:unpadded-base64url-public-key entries.
PUBLIC_COMMONS_VERIFYING_KEYS=development:Laz0b4AQMs1TfE090-MRSPubDqxptaEJ-HZXEsZe_lw
PUBLIC_COMMONS_STALE_AFTER_SECONDS=300
TARGET_KCAL_FLOOR=1200
OPEN_FOOD_FACTS_ENABLED=false
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_SECONDS=3
OPEN_FOOD_FACTS_USER_AGENT_CONTACT=https://github.com/RujitRaval/opennosh
OPEN_FOOD_FACTS_LOOKUP_RATE_LIMIT_ATTEMPTS=10
OPEN_FOOD_FACTS_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=60
OPEN_FOOD_FACTS_UPSTREAM_RATE_LIMIT_ATTEMPTS=10
OPEN_FOOD_FACTS_UPSTREAM_RATE_LIMIT_WINDOW_SECONDS=60
OPEN_FOOD_FACTS_EXPORT_RATE_LIMIT_ATTEMPTS=10
OPEN_FOOD_FACTS_EXPORT_RATE_LIMIT_WINDOW_SECONDS=60
OPEN_FOOD_FACTS_EXPORT_STATEMENT_TIMEOUT_MS=2000
COMMUNITY_EXPORT_RATE_LIMIT_ATTEMPTS=10
COMMUNITY_EXPORT_RATE_LIMIT_WINDOW_SECONDS=60
COMMUNITY_EXPORT_STATEMENT_TIMEOUT_MS=2000
PRIVATE_EXPORT_RATE_LIMIT_ATTEMPTS=10
PRIVATE_EXPORT_RATE_LIMIT_WINDOW_SECONDS=60
PRIVATE_EXPORT_STATEMENT_TIMEOUT_MS=5000
PUBLIC_EXPORT_CONCURRENCY_LIMIT=2
PRIVATE_EXPORT_CONCURRENCY_LIMIT=1
EXPORT_CAPACITY_WAIT_SECONDS=1
PUBLIC_EXPORT_RESPONSE_TIMEOUT_SECONDS=300
PRIVATE_EXPORT_RESPONSE_TIMEOUT_SECONDS=1800
