{
  "name": "opennosh-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run check:design-build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "check:visual-baselines": "node scripts/check_visual_baselines.mjs",
    "test:localization": "playwright test --config playwright.localization.config.ts",
    "check:localization": "node scripts/check_localized_ui_copy.mjs",
    "check:design-system": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check_living_commons_design_system.mjs",
    "check:design-build": "node scripts/check_production_font_isolation.mjs",
    "check:motion-budgets": "node scripts/check_public_motion_budgets.mjs",
    "benchmark:motion": "node scripts/benchmark_public_motion.mjs",
    "generate:api-contracts": "node ../scripts/generate_web_contracts.mjs",
    "check:api-contracts": "npm run generate:api-contracts && git diff --exit-code -- lib/generated"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@hey-api/openapi-ts": "0.97.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
